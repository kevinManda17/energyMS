<TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT">password</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#546E7A">texte(128)</FONT></TD></TR>
<TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT">last_login</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#546E7A">horodatage?</FONT></TD></TR>
<TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT">is_superuser</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#546E7A">bool</FONT></TD></TR>
<TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#546E7A">texte(150) ∪</FONT></TD></TR>
<TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT">first_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#546E7A">texte(150)</FONT></TD></TR>
<TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT">last_name</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#546E7A">texte(150)</FONT></TD></TR>
<TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT">is_staff</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#546E7A">bool</FONT></TD></TR>
<TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#546E7A">bool</FONT></TD></TR>
<TR><TD ALIGN="LEFT" WIDTH="26"></TD><TD ALIGN="LEFT">date_joined</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#546E7A">horodatage</FONT></TD></TR>
