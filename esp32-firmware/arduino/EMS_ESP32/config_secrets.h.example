/*
 * config_secrets.h.example — modele des identifiants Wi-Fi du noeud.
 *
 * A COPIER en `config_secrets.h` dans CE dossier, puis a completer. Le fichier
 * copie est ignore par git (.gitignore) : il ne partira jamais sur GitHub.
 *
 *     cp config_secrets.h.example config_secrets.h
 *
 * L'Arduino IDE compile automatiquement tous les fichiers du dossier du
 * croquis : aucun reglage supplementaire n'est necessaire.
 *
 * Reseau ouvert (hotspot sans mot de passe) : laisser WIFI_PASSWORD vide.
 */

#pragma once

constexpr const char* WIFI_SSID     = "NOM_DU_RESEAU";
constexpr const char* WIFI_PASSWORD = "MOT_DE_PASSE";
